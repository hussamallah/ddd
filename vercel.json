{
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web-app/.next",
  "framework": "nextjs",
  "installCommand": "npm install",
  "functions": {
    "apps/web-app/src/app/api/**/*.ts": {
      "runtime": "nodejs18.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}
